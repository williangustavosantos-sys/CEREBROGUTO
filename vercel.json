{
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "node_modules/highs/build/highs.wasm"
    }
  },
  "crons": [
    {
      "path": "/guto/push/dispatch",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
